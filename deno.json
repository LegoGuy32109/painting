{
  "tasks": {
    "dev": "deno run -A --env-file src/server/main.ts",
    "check": "deno check src tests scripts",
    "test": "deno test --allow-read=public,src/client --ignore=tests/db_test.ts,tests/sync-routes_test.ts tests",
    "test:db": "deno test --allow-net --allow-env --allow-read tests/db_test.ts",
    "test:routes": "deno test --allow-net --allow-env --allow-read tests/sync-routes_test.ts",
    "test:e2e": "deno run --allow-net --allow-env --allow-read --allow-run scripts/ephemeral-test-db.ts",
    "seed:dev": "deno run --allow-net --allow-env scripts/seed-dev-canvases.ts"
  },
  "compilerOptions": {
    "checkJs": true,
    "lib": ["dom", "dom.iterable", "deno.ns"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@tursodatabase/serverless/compat": "npm:@tursodatabase/serverless@1.4.0/compat"
  },
  "deploy": {
    "org": "legoguy32109",
    "app": "painting",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "./src/main.ts"
    }
  }
}







































